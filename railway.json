{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "[ -d backend ] && (cd backend && npm install) || npm install"
  },
  "deploy": {
    "startCommand": "node ${APP_PATH:-backend}/server.js || node server.js",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
